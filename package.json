{
  "name": "novel-setting-manager",
  "version": "1.2.0",
  "description": "小说设定管理工具（多项目便携版）",
  "author": "ysqjl <ysqjl@outlook.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder"
  },
  "build": {
    "appId": "com.novel.tool",
    "productName": "小说设定管理器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "icon.png",
      "icon-small.png",
      "icon-96.png",
      "小说库/使用教程.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "README.md",
      "docs/**",
      "node_modules/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}